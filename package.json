{
	"name": "houses-of-the-green-dragon",
	"private": true,
	"version": "0.4.14",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"start-server": "PORT=5174 ORIGIN=https://enzlor.uber.space node --env-file=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"uuid": "^11.1.1"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.13.13",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.3.2",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"sqlite3": "^6.0.1",
		"svelte": "^5.23.1",
		"svelte-check": "^4.1.5",
		"tailwindcss": "^4.0.14",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.2.2",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"bcrypt-ts": "^9.0.2",
		"mariadb": "^3.5.3",
		"sequelize": "^6.37.8",
		"umzug": "^3.8.3"
