# Vorlage für die .env — kopieren und anpassen. Die echte .env wird nicht versioniert
# und auch beim Deploy nicht überschrieben (--exclude im rsync-Aufruf).

# Lokale Entwicklung ohne MariaDB: Der Wert `dev` schaltet auf eine SQLite-Datei unter
# .data/dev.sqlite um. Die Welt überlebt damit einen Neustart des Servers.
MARIA_DB_NAME=dev

# In Produktion: Name der Datenbank OHNE den Benutzerpräfix, den Uberspace voranstellt.
# Aus MARIA_DB_USER=enzlor und MARIA_DB_NAME=drache wird die Datenbank enzlor_drache.
#MARIA_DB_NAME=drache
#MARIA_DB_USER=
#MARIA_DB_PASSWORD=
